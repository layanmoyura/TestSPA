@{
    ViewData["Title"] = "Product Management";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Product Management</h2>

    <!-- Product Form -->
    <div class="card shadow-lg">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4" style="display: none;">
                    <input type="hidden" id="productId">
                </div>
                <div class="col-md-4">
                    <input type="text" id="name" class="form-control" placeholder="Product Name">
                </div>
                <div class="col-md-3">
                    <input type="number" id="price" class="form-control" placeholder="Price">
                </div>
                <div class="col-md-3">
                    <input type="number" id="stock" class="form-control" placeholder="Stock">
                </div>
                <div class="col-md-2">
                    <button id="btnSave" class="btn btn-primary w-100" onclick="saveProduct()">Add Product</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Product List -->
    <div class="mt-4">
        <table class="table table-bordered table-striped text-center">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="productTable"></tbody>
        </table>
    </div>
</div>



